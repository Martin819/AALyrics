<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Car App Library permissions. We don't actually render onto the car
         surface or use navigation/map templates, but Google's own Showcase
         sample declares these and consumer Android Auto on Pixel + Android 16
         appears to gate templated-app discovery on at least one of them being
         present. Cheap to declare. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".AALyricsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AALyrics"
        android:largeHeap="true"
        tools:targetApi="31">

        <!-- Android Auto descriptor -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Identifies the app icon used in the car media UI -->
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_lyrics" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AALyrics">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NotificationListenerService — fallback for reading media notifications -->
        <service
            android:name=".service.MediaNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Foreground service that holds the MediaSession we use ON THE PHONE
             (notification, observing playback from Spotify / YT Music). We do
             NOT expose this to Android Auto — see automotive_app_desc.xml — because
             we don't actually play audio and AA's media template requires playable
             items. Lyrics in AA are delivered via LyricsCarAppService below. -->
        <service
            android:name=".service.KaraokeMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Car App Service: the SOLE Android Auto surface. Provides the
             custom multi-line karaoke screen via Car App Library
             (PaneTemplate / LongMessageTemplate).

             Category=POI because AA's launcher discovers POI apps in every
             current AA host version; IOT was hit-or-miss across devices.
             PaneTemplate is allowed in POI since Car App Library 1.4. -->
        <service
            android:name=".service.car.LyricsCarAppService"
            android:exported="true"
            android:icon="@drawable/ic_lyrics"
            android:label="@string/app_name"
            android:foregroundServiceType="connectedDevice">
            <!-- One intent-filter only, matching Google's HelloWorld sample.
                 Some AA hosts (notably AA 16.x on Pixel) silently skip
                 services that declare multiple intent-filters with the same
                 action but different categories. -->
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

    </application>
</manifest>
