<?xml version="1.0" encoding="utf-8"?>
<!--
  Only "media" use case. We tried "template" with a CarAppService for
  multi-line lyrics, but AA 16.x on Pixel + Android 16 silently filters
  sideloaded templated apps regardless of category. The media surface is
  what AA actually shows, so we expose lyrics as a MediaBrowserService
  browse tree instead — see KaraokeMediaService.
-->
<automotiveApp>
    <uses name="media" />
</automotiveApp>
